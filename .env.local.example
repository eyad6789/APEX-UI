# ─── The brain ────────────────────────────────────────────────────────────────
# Gemini answers by default. If it is unreachable or out of quota, the local
# open model below takes over so Apex still replies.
GEMINI_API_KEY=
APEX_MODEL=                      # optional, default gemini-3.7-flash

# APEX_BRAIN=gemini   → Gemini only, no fallback
# APEX_BRAIN=local    → the local model only (offline)
# unset / auto        → Gemini first, local model as the safety net
APEX_BRAIN=

# The offline brain, served by Ollama:  ollama pull qwen2.5:7b-instruct
OLLAMA_HOST=                     # optional, default http://127.0.0.1:11434
APEX_LOCAL_MODEL=                # optional, default qwen2.5:7b-instruct

# ─── The voice ────────────────────────────────────────────────────────────────
# ElevenLabs is used when a key is present; otherwise (or if it fails mid-request)
# Apex falls back to the local open-source voices, then to macOS `say`.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=             # a library voice needs a paid plan; falls back to stock "Daniel"
ELEVENLABS_MODEL=                # optional, default eleven_multilingual_v2

# APEX_TTS pins one engine: elevenlabs | piper | kokoro | say | auto
APEX_TTS=

# Piper - the default local voice.  npm run tts:setup
PIPER_BIN=                       # default .venv-tts/bin/piper
PIPER_MODEL=                     # default voices/en_GB-alan-medium.onnx
PIPER_LENGTH_SCALE=              # optional, higher = slower. default 1.05

# Kokoro - the richer local voice.  npm run tts:setup:kokoro
KOKORO_PYTHON=                   # default .venv-tts/bin/python
KOKORO_VOICE=                    # default bm_george

SAY_VOICE=                       # macOS fallback voice, default Daniel

# ─── The schedule ─────────────────────────────────────────────────────────────
APEX_SCHEDULE_FILE=              # default data/schedule.json
